# ---------------------------------------------------------------------------
# AADRIQUE API — copy to backend/.env and fill in.
# Never commit the real .env.
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development

# --- Database (required) ---------------------------------------------------
# Local:  mongodb://localhost:27017
# Docker: mongodb://mongo:27017
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=aadrique

# --- CORS (required in production) -----------------------------------------
# Exact browser origins allowed to call this API. Comma-separated, no trailing slash.
# Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000

# --- Admin API (required in production) ------------------------------------
# Guards GET /api/enquiries, which returns stored customer personal data.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank in development to disable the endpoint entirely.
ADMIN_TOKEN=

# Google accounts allowed into the admin dashboard (/admin), comma-separated.
# They sign in with Google; everyone else is refused. Needs GOOGLE_CLIENT_ID.
ADMIN_EMAILS=

# --- Google Sign-In (AI Engineering Programme applications) -----------------
# Students sign in with Google before applying. Create an OAuth 2.0 Client ID
# (type: Web application) in Google Cloud Console → APIs & Services → Credentials,
# and add your site origins (https://www.aadrique.in, http://localhost:3000) under
# "Authorized JavaScript origins". No client secret is needed.
# Leave blank to disable applications (the apply page then points to the contact form).
GOOGLE_CLIENT_ID=

# Razorpay payment link for the programme fee (shown after a student applies).
# Students pay there and report the payment ID; the team verifies it in /admin.
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@kondusrivardhanrao

# --- Transactional email (optional, via Resend) -----------------------------
# Without these, enquiries are still stored — no notification emails are sent.
# 1. Create an account at resend.com and verify the aadrique.in sending domain
#    (Resend gives you SPF/DKIM/DMARC DNS records to add — no real mailbox needed).
# 2. Create an API key in the Resend dashboard.
RESEND_API_KEY=
# Must be an address on the verified domain, e.g. no-reply@aadrique.in.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=AADRIQUE
# Where the "new enquiry" notification is sent.
OWNER_EMAIL=gunasanjaysagar.m@aadrique.in

# --- Networking ------------------------------------------------------------
# Set to true ONLY when the API sits behind a reverse proxy you control
# (nginx, Cloudflare, ALB). It makes the rate limiter trust X-Forwarded-For;
# enabling it on a directly exposed API lets clients spoof their IP.
TRUST_PROXY=false

# --- Contact form rate limit ----------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=60

# --- Seeding ---------------------------------------------------------------
# Re-seeds CMS content when seed_data.py's SEED_VERSION changes.
SEED_ON_STARTUP=true
